# ====================================================================
# Legacy Logic Pro — Backend Environment Configuration Example
# Copy to .env and populate with production values before running
# ====================================================================

# Port for FastAPI Uvicorn ASGI server (defaults to 8000 locally, Railway injects PORT automatically)
PORT=8000

# Environment mode: 'development' or 'production'
ENVIRONMENT=production

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Service Role Key (used server-side for administrative operations and row-level checks)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Supabase JWT Secret (found under Project Settings > API > JWT Settings; used to verify Bearer tokens)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# CORS Allowed Origins: comma-separated list of origins (no trailing slash, strictly matched)
ALLOWED_ORIGINS=https://legacy-logic-pro.vercel.app,http://localhost:3000

# Google Gemini API Key (used server-side for Gemini 3.1 Pro High Thinking queries when opted in)
GEMINI_API_KEY=your-google-gemini-api-key-here

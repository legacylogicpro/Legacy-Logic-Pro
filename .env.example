# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini 3.1 Pro Thinking Mode).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_API_URL: Single base URL for backend API calls
NEXT_PUBLIC_API_URL="http://localhost:8000"

# SUPABASE_URL: URL of your Supabase PostgreSQL project
SUPABASE_URL="https://your-supabase-project.supabase.co"

# SUPABASE_SERVICE_KEY: Supabase service role key for backend administration
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# SUPABASE_JWT_SECRET: Secret used to verify incoming Supabase JWT tokens
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"


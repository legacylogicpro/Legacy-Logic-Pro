# ====================================================================
# Legacy Logic Pro — Frontend Environment Configuration Example
# Copy to .env.local for local Next.js development
# ====================================================================

# Single unified backend base URL (Section 3.1: no other base URL constants permitted)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Client URL (public project URL for Supabase Auth in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (browser-safe public key for Supabase Auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
